# Optional OSRM-compatible routing endpoint.
# The endpoint must accept /{originLng},{originLat};{destinationLng},{destinationLat}
# and return an OSRM route response with GeoJSON geometry.
# alternatives=true is requested so providers can return multiple candidates.
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Optional geocoding endpoint for place-name origin/destination input.
# It must accept ?q=<name>&format=jsonv2&limit=1 and return lat/lon fields.
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
